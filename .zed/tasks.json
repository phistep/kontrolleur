[
  /// Micro Python
  {
    "label": "Serial Connection (REPL)",
    // "command": "picocom $PORT -b$BAUD",
    "command": "mpremote connect auto",
    // "env": {
    //   "PORT": "/dev/cu.usbmodem21201",
    //   "BAUD": "115200"
    // },
    "shell": "system"
  },
  {
    "label": "MicroPython Run",
    "command": "mpremote run $ZED_FILE",
    "env": {
      "PORT": "/dev/cu.usbmodem21201"
    },
    "shell": "system",
    "tags": ["python-main"]
  },
  {
    "label": "MicroPython Upload",
    "command": "mpremote cp $ZED_FILE :$ZED_FILENAME",
    "env": {
      "PORT": "/dev/cu.usbmodem21201"
    },
    "shell": "system",
    "tags": ["python-main"]
  },
  {
    "label": "MicroPython Upload main.py",
    "command": "mpremote cp $ZED_FILE :main.py",
    "env": {
      "PORT": "/dev/cu.usbmodem21201"
    },
    "shell": "system",
    "tags": ["python-main"]
  },
  {
    "label": "CircuitPython Upload code.py",
    "command": "cp $ZED_FILE /Volumes/CIRCUITPY/code.py",
    "shell": "system",
    "tags": ["python-main"]
  },
  {
    "label": "install.sh",
    "command": "$ZED_WORKTREE_ROOT/install.sh",
    "shell": "system"
  },
{
  "label": "install.sh --dev",
  "command": "$ZED_WORKTREE_ROOT/install.sh",
  "args": ["--dev"],
  "shell": "system"
}
]
